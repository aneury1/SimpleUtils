@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(wxWidgets REQUIRED COMPONENTS core base)
if(@UIUTILS_ENABLE_CODES@)
    find_dependency(ZXing 2.2 CONFIG REQUIRED)
endif()
if(@UIUTILS_ENABLE_PDF@)
    find_dependency(PkgConfig REQUIRED)
    pkg_check_modules(POPPLER_CPP REQUIRED IMPORTED_TARGET poppler-cpp)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/uiutilsTargets.cmake")
check_required_components(uiutils)
