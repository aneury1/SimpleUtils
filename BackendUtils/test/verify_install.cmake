cmake_minimum_required(VERSION 3.16)
if(NOT SOURCE_DIR OR NOT BUILD_ROOT)
  message(FATAL_ERROR "Specify SOURCE_DIR and BUILD_ROOT as absolute paths")
endif()
if(NOT IS_ABSOLUTE "${SOURCE_DIR}" OR NOT IS_ABSOLUTE "${BUILD_ROOT}")
  message(FATAL_ERROR "SOURCE_DIR and BUILD_ROOT must be absolute")
endif()
string(TIMESTAMP stamp "%Y%m%d%H%M%S")
set(root "${BUILD_ROOT}/verify-${stamp}")
function(run)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE result)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Installation verification failed: ${ARGV}")
  endif()
endfunction()
run(${CMAKE_COMMAND} -S "${SOURCE_DIR}" -B "${root}/library" -DSIMPLEUTILS_BUILD_TESTS=OFF -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=${root}/prefix)
run(${CMAKE_COMMAND} --build "${root}/library" --config Release --parallel 2)
run(${CMAKE_COMMAND} --install "${root}/library" --config Release)
file(RENAME "${root}/prefix" "${root}/relocated")
run(${CMAKE_COMMAND} -S "${SOURCE_DIR}/test/install_consumer" -B "${root}/consumer" -DCMAKE_PREFIX_PATH=${root}/relocated -DCMAKE_BUILD_TYPE=Release)
run(${CMAKE_COMMAND} --build "${root}/consumer" --config Release --parallel 2)
if(EXISTS "${root}/consumer/Release/consumer.exe")
  run("${root}/consumer/Release/consumer.exe")
elseif(EXISTS "${root}/consumer/consumer.exe")
  run("${root}/consumer/consumer.exe")
else()
  run("${root}/consumer/consumer")
endif()
message(STATUS "Installed and relocated package consumer passed")
